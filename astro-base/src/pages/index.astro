---
import '../styles/global.css';
import '../styles/home.css';
import { getCollection } from 'astro:content';
import { transferImagesFormat } from '@/composables/transferImagesFormat';
import { buildNoteIndex } from '@/composables/buildNoteIndex';
import HomeIntro from '@/components/home/HomeIntro.astro';
import HomeArticleGallery from '@/components/home/HomeArticleGallery.astro';
import HomeNoteSlider from '@/components/home/HomeNoteSlider.astro';
import DefaultLayout from '@/layouts/Default.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';

const articles = await transferImagesFormat(
  await getCollection('articles'),
  'webp'
);
const recentArticles = articles
  .sort(
    (a, b) => b.data.date.localeCompare(a.data.date) || a.id.localeCompare(b.id)
  )
  .slice(0, 4);
const noteEntries = await getCollection(
  'notes',
  ({ data }) => import.meta.env.DEV || !data.draft
);
const noteIndex = await buildNoteIndex(noteEntries);
const recentNotes = noteIndex.notes.slice(0, 10);
---

<DefaultLayout title={SITE_TITLE} description={SITE_DESCRIPTION} currentPage="">
  <main class="home-shell">
    <HomeIntro />
    <HomeArticleGallery articles={recentArticles} />
    <HomeNoteSlider notes={recentNotes} />
  </main>
</DefaultLayout>

<script>
  const reveal = document.querySelectorAll<HTMLElement>(
    '.home-reveal, .home-article-media'
  );
  if (
    reveal.length &&
    !matchMedia('(prefers-reduced-motion: reduce)').matches &&
    'IntersectionObserver' in window
  ) {
    document.documentElement.classList.add('home-has-motion');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px' }
    );
    reveal.forEach((element) => observer.observe(element));
  }
  document
    .querySelectorAll<HTMLImageElement>('.home-article-media img')
    .forEach((image) => {
      const fail = () => image.parentElement?.classList.add('is-failed');
      image.addEventListener('error', fail, { once: true });
      if (image.complete && !image.naturalWidth) fail();
    });
</script>
