---
import { Font } from 'astro:assets';
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/react/Header';
import FooterContainer from '@/components/FooterContainer.astro';

interface Props {
  title: string;
  description?: string;
  currentPage?: string;
  image?: string;
  notesIndex?: boolean;
}

const { title, description, image, notesIndex = false } = Astro.props;
const currentPage = Astro.props.currentPage ?? Astro.url.pathname.split('/')[1];
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead
      title={title}
      description={description ?? 'Default Description'}
      image={image}
    />
    <slot name="head" />
    <Font cssVariable="--font-pretendard" preload />
  </head>
  <body class:list={[{ 'notes-index-page': notesIndex }]}>
    <Header client:load currentPage={currentPage} />
    <slot />
    {!notesIndex && <FooterContainer />}
    <script>
      const documentElement = document.documentElement;
      let theme = 'light';
      try {
        theme = localStorage.getItem('theme') ?? 'light';
      } catch {
        /* Theme remains usable without storage. */
      }

      theme === 'dark'
        ? documentElement.classList.add('dark')
        : documentElement.classList.remove('dark');
    </script>
  </body>
</html>
